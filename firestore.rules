rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for sentiment data (Guest access)
    match /sentimentLatest/{ticker} {
      allow read: if true;
      allow write: if false; 
    }
    match /sentimentHistorical/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /rawMentions/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
